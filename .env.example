# Public base URL of this deployment, e.g. https://your-app.vercel.app
APP_URL=

# Supabase Storage (reserved for ZIP uploads; not used by this foundation release)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_UPLOAD_BUCKET=
